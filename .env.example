# Database Configuration
POSTGRES_USER=evenly
POSTGRES_PASSWORD=evenly
POSTGRES_DB=evenly
DATABASE_PORT=5432

# Backend Configuration (evenly-core)
# Note: DB_URL is automatically constructed from POSTGRES_DB
# DB_USER and DB_PASSWORD default to 'evenly' if not set
# Set them explicitly if they differ from POSTGRES_USER/POSTGRES_PASSWORD
DB_USER=evenly
DB_PASSWORD=evenly
JWT_SECRET=fe97b7ab529670b6f9ea2378a0ea6ad8

# Frontend Configuration (evenly-webapp)
NUXT_PUBLIC_API_BASE=http://localhost:8080
NUXT_PUBLIC_KEYCLOAK_URL=http://localhost:9090
POCKITO_API_BASE=http://localhost:8181
NUXT_PUBLIC_KEYCLOAK_REALM=evenly
NUXT_PUBLIC_KEYCLOAK_CLIENT_ID=evenly-web


# Port Configuration
API_PORT=8080
WEBAPP_PORT=3000

# WireMock Configuration
WIREMOCK_OPTIONS=--global-response-templating --verbose
