<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="evenly" transaction-type="JTA">
        <description>Evenly Core Persistence Unit - JTA with Hibernate and Narayana</description>
        <!-- Entity classes are automatically discovered via @Entity annotations -->
        <!-- JTA DataSource is configured programmatically in EntityManagerFactoryProducer -->
        <!-- Hibernate settings are configured programmatically in EntityManagerFactoryProducer -->
    </persistence-unit>
</persistence>
