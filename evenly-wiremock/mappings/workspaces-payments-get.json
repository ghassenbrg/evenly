{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPathPattern": "/api/workspaces/([a-z0-9-]+)/payments/([a-z0-9-]+)"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Credentials": "true",
      "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS, HEAD",
      "Access-Control-Allow-Headers": "origin, content-type, accept, authorization"
    },
    "jsonBody": {
      "id": "{{request.pathSegments.[3]}}",
      "workspaceId": "{{request.pathSegments.[1]}}",
      "payerId": "user-bob",
      "payeeId": "user-alice",
      "amount": 38500,
      "currency": "JPY",
      "type": "EXPENSE_SETTLEMENT",
      "status": "COMPLETED",
      "note": "Settlement payment for shared expenses",
      "createdAt": "{{now offset='-1 days'}}",
      "payer": {
        "id": "user-bob",
        "email": "bob@example.com",
        "displayName": "Bob",
        "username": "bob",
        "preferredCurrency": "JPY"
      },
      "payee": {
        "id": "user-alice",
        "email": "alice@example.com",
        "displayName": "Alice",
        "username": "alice",
        "preferredCurrency": "JPY"
      }
    },
    "transformers": ["response-template"]
  }
}

