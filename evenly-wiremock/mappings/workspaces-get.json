{
  "request": {
    "method": "GET",
    "urlPathPattern": "/api/workspaces/([a-z0-9-]+)",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*"
    },
    "jsonBody": {
      "id": "{{request.pathSegments.[1]}}",
      "name": "Workspace",
      "defaultSplitMode": "EQUAL",
      "currency": "JPY",
      "createdAt": "2024-01-01T00:00:00Z",
      "updatedAt": "{{now}}"
    },
    "transformers": ["response-template"]
  }
}
