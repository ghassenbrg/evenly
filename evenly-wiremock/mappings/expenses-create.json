{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/api/workspaces/([a-z0-9-]+)/expenses",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      },
      "Content-Type": {
        "equalTo": "application/json"
      }
    }
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Credentials": "true",
      "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS, HEAD",
      "Access-Control-Allow-Headers": "origin, content-type, accept, authorization"
    },
    "jsonBody": {
      "data": {
        "id": "exp-{{randomValue type='UUID'}}",
        "categoryId": "{{jsonPath request.body '$.categoryId'}}",
        "categoryName": "Groceries",
        "categoryIcon": "groceries",
        "categoryColor": "#10b981",
        "amount": "{{jsonPath request.body '$.amount'}}",
        "currency": "JPY",
        "effectiveDate": "{{jsonPath request.body '$.date'}}",
        "note": "{{jsonPath request.body '$.note'}}",
        "status": "ACTIVE",
        "paidByUserId": "{{jsonPath request.body '$.paidByUserId'}}",
        "paidByUserName": "{{jsonPath request.body '$.paidByUserId'}}"
      }
    },
    "transformers": ["response-template"]
  }
}

