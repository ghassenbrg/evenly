{
  "request": {
    "method": "GET",
    "urlPath": "/api/workspaces",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*"
    },
    "bodyFileName": "workspaces.json"
  }
}

