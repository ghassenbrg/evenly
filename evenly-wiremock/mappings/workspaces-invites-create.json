{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/api/workspaces/([a-z0-9-]+)/invites",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      },
      "Content-Type": {
        "equalTo": "application/json"
      }
    }
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Credentials": "true",
      "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS, HEAD",
      "Access-Control-Allow-Headers": "origin, content-type, accept, authorization"
    },
    "jsonBody": {
      "id": "invite-{{randomValue type='UUID'}}",
      "workspaceId": "{{request.pathSegments.[1]}}",
      "code": "{{randomValue length=6 type='ALPHANUMERIC'}}",
      "maxUses": 10,
      "usesCount": 0,
      "expiresAt": "{{now offset='7 days'}}",
      "createdAt": "{{now}}"
    },
    "transformers": ["response-template"]
  }
}

