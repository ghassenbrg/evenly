{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/api/workspaces/([a-z0-9-]+)/categories",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      },
      "Content-Type": {
        "equalTo": "application/json"
      }
    }
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Credentials": "true",
      "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS, HEAD",
      "Access-Control-Allow-Headers": "origin, content-type, accept, authorization"
    },
    "jsonBody": {
      "id": "cat-{{randomValue type='UUID'}}",
      "workspaceId": "{{request.pathSegments.[1]}}",
      "name": "{{jsonPath request.body '$.name'}}",
      "slug": "{{lowercase (jsonPath request.body '$.name')}}",
      "icon": "{{jsonPath request.body '$.icon'}}",
      "color": "{{jsonPath request.body '$.color'}}",
      "isActive": true,
      "sortOrder": 10,
      "createdAt": "{{now}}",
      "updatedAt": "{{now}}"
    },
    "transformers": ["response-template"]
  }
}

