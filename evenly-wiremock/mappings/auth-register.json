{
  "request": {
    "method": "POST",
    "urlPath": "/auth/register",
    "headers": {
      "Content-Type": {
        "equalTo": "application/json"
      }
    },
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.email",
        "matchesJsonPath": "$.password",
        "matchesJsonPath": "$.displayName",
        "matchesJsonPath": "$.username",
        "matchesJsonPath": "$.preferredCurrency"
      }
    ]
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type, Authorization"
    },
    "jsonBody": {
      "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLW5ldyIsImVtYWlsIjoi{{jsonPath request.body '$.email'}}",
      "user": {
        "id": "user-new",
        "email": "{{jsonPath request.body '$.email'}}",
        "displayName": "{{jsonPath request.body '$.displayName'}}",
        "username": "{{jsonPath request.body '$.username'}}",
        "preferredCurrency": "{{jsonPath request.body '$.preferredCurrency'}}",
        "createdAt": "{{now}}"
      }
    },
    "transformers": ["response-template"]
  }
}

