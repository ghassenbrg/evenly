{
  "request": {
    "method": "POST",
    "urlPath": "/api/workspaces",
    "headers": {
      "Authorization": {
        "matches": "Bearer .+"
      },
      "Content-Type": {
        "equalTo": "application/json"
      }
    }
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Credentials": "true",
      "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS, HEAD",
      "Access-Control-Allow-Headers": "origin, content-type, accept, authorization"
    },
    "jsonBody": {
      "id": "ws-{{randomValue type='UUID'}}",
      "name": "{{jsonPath request.body '$.name'}}",
      "defaultSplitMode": "{{jsonPath request.body '$.defaultSplitMode'}}",
      "monthlySharedLimit": "{{jsonPath request.body '$.monthlySharedLimit'}}",
      "currency": "{{jsonPath request.body '$.currency'}}",
      "isPersonal": false,
      "createdAt": "{{now}}",
      "updatedAt": "{{now}}"
    },
    "transformers": ["response-template"]
  }
}

